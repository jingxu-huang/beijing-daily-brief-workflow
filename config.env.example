# Copy to config.env. This local file is gitignored.

# Required: a persistent directory outside this Git checkout. An external
# volume is recommended for report history. If you intentionally use the
# system disk, set RIBAO_ALLOW_SYSTEM_DATA_ROOT=1 yourself before installing
# the daily guard; bootstrap never adds that override automatically.
RIBAO_DATA_ROOT="/path/to/external-volume/beijing-daily-brief-data"
RIBAO_ALLOW_SYSTEM_DATA_ROOT=0

# Capability switches. Public-source local generation + QA is always installed.
# Enable optional capabilities only after the corresponding account owner is ready.
RIBAO_ENABLE_FEISHU=0
# WeWe RSS has been retired from the formal production path.  It is retained
# only as a historical local project; the installed guard forcibly excludes it.
RIBAO_ENABLE_WEWE=0
RIBAO_WEWE_RETIRED=1
# Legacy WeRSS remains in source control for audit, but is not approved for
# production or the isolated test matrix.
RIBAO_ENABLE_WERSS=0
# Media is independent from text QA: 1 prefetches and visually audits candidate
# images; any media failure is a WARN and leaves the completed text untouched.
RIBAO_ENABLE_REPORT_IMAGES=1
RIBAO_IMAGE_AUDIT_TIMEOUT_SECONDS=45

# Used only when RIBAO_ENABLE_FEISHU=1. This mode creates/updates Feishu Docx
# without granting a group permission or sending IM. Enable the stable daily
# index only after restoring and confirming its private registry.
FEISHU_REPORT_CHAT_ID=
# Optional separate strategic-group audience for test docs/index; blank means
# use FEISHU_REPORT_CHAT_ID. It controls permissions, never group messages.
FEISHU_TEST_INDEX_CHAT_ID=
FEISHU_REPORT_CHAT_PERM=full_access
FEISHU_CLI_SEND_AS=bot
FEISHU_CLI_IMPORT_AS=bot
FEISHU_CLI_PERMISSION_AS=user
FEISHU_DOC_ONLY=1
FEISHU_DAILY_INDEX=0
FEISHU_DAILY_INDEX_TITLE="资讯日报链接索引"
# 0 = never send report, WeWe, or deadline messages to the group.
RIBAO_GROUP_MESSAGES=0

# Optional isolated test runtime. Defaults to "$RIBAO_DATA_ROOT/测试版".
# Keep on the same dedicated data volume, but never equal production root.
RIBAO_TEST_DATA_ROOT=
RIBAO_TEST_CODEX_AUDIT_MODE=auto

# Codex CLI model and existing authenticated Codex home.
RIBAO_CODEX_MODEL=gpt-5.6-sol
RIBAO_EXISTING_CODEX_HOME="$HOME/.codex"

# Optional: pin the workflow to a project virtualenv instead of macOS /usr/bin/python3.
RIBAO_PYTHON_BIN="/path/to/venv/bin/python3"

# Optional: use a self-hosted RSSHub for public routes instead of rsshub.app.
RIBAO_RSSHUB_BASE="http://127.0.0.1:1200"

# Historical WeWe RSS settings. They are ignored by the formal daily workflow
# and retained only so prior local records remain understandable.
WEWE_RSS_URL=http://127.0.0.1:4000
WEWE_ALL_FEED_URL=http://localhost:4000/feeds/all.rss
WEWE_AUTH_CODE=

# The WeWe relogin installer generates these in config.env when blank.
RELOGIN_TOKEN=
RELOGIN_ADMIN_TOKEN=
RELOGIN_PORT=4001
RELOGIN_API_URL=http://127.0.0.1:4001
# 0 = local QR page only. Set to 1 only when a remote/cloudflared QR page is needed.
RIBAO_ENABLE_REMOTE_RELOGIN=0
TUNNEL_TTL_MINUTES=360

# Historical WeWe reminder schedule (not installed or executed in production).
RIBAO_WEWE_CHECK_1=11:00
RIBAO_WEWE_REFRESH_1=12:00
RIBAO_WEWE_CHECK_2=14:30
