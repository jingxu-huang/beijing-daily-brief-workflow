# Copy to config.env. This local file is gitignored.

# Required: a directory on a dedicated external/non-root mounted volume.
RIBAO_DATA_ROOT="/path/to/external-volume/beijing-daily-brief-data"

# Current default delivery mode: create/update Feishu Docx and the stable daily
# index document, without granting a group permission or sending group messages.
FEISHU_REPORT_CHAT_ID=
FEISHU_REPORT_CHAT_PERM=edit
FEISHU_CLI_SEND_AS=bot
FEISHU_CLI_IMPORT_AS=bot
FEISHU_CLI_PERMISSION_AS=user
FEISHU_DOC_ONLY=1
FEISHU_DAILY_INDEX=1
FEISHU_DAILY_INDEX_TITLE="资讯日报链接索引"

# Codex CLI model and existing authenticated Codex home.
RIBAO_CODEX_MODEL=gpt-5.6-sol
RIBAO_EXISTING_CODEX_HOME="$HOME/.codex"

# Optional: pin the workflow to a project virtualenv instead of macOS /usr/bin/python3.
RIBAO_PYTHON_BIN="/path/to/venv/bin/python3"

# Optional: use a self-hosted RSSHub for public routes instead of rsshub.app.
RIBAO_RSSHUB_BASE="http://127.0.0.1:1200"

# WeWe RSS. Choose a strong local dashboard password.
WEWE_RSS_URL=http://127.0.0.1:4000
WEWE_ALL_FEED_URL=http://localhost:4000/feeds/all.rss
WEWE_AUTH_CODE=

# The WeWe relogin installer generates these in config.env when blank.
RELOGIN_TOKEN=
RELOGIN_ADMIN_TOKEN=
RELOGIN_PORT=4001
RELOGIN_API_URL=http://127.0.0.1:4001
TUNNEL_TTL_MINUTES=360

# Fixed workflow contract. The guard rejects changed reminder times.
RIBAO_WEWE_CHECK_1=11:00
RIBAO_WEWE_REFRESH_1=12:00
RIBAO_WEWE_CHECK_2=14:30
