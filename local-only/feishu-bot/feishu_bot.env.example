# Copy this file to `feishu_bot.env` and fill in your personal Feishu bot config.
# Keep `feishu_bot.env` local. Do not upload it to GitHub.

FEISHU_BOT_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/REPLACE_ME

# Optional. The bot is notification-only; it does not create Docs.
# Set FEISHU_DISABLE_BOT=1 to create the Feishu Doc but not send a bot message.
# Recommended for accounts where the bot is not connected to API capabilities.
FEISHU_BOT_SECRET=
FEISHU_DISABLE_BOT=1

# Optional. Use 1 to print the payload without sending.
FEISHU_BOT_DRY_RUN=0

# Optional. The sender splits long reports into multiple messages.
FEISHU_BOT_MAX_CHARS=18000

# Current daily automation uses send_to_feishu_cli.py + lark-cli by default.
# These options are for the current lark-cli route.
FEISHU_REPORT_CHAT_ID=
FEISHU_REPORT_CHAT_PERM=edit
# Keep bot until im:message.send_as_user is approved; then this can be changed to user.
FEISHU_CLI_SEND_AS=bot

# Legacy send mode for send_to_feishu_bot.py:
# - app_doc: create Docx with the Feishu app API, then optionally send an interactive card to FEISHU_CHAT_ID
# - text: send the full Markdown report as chat text
# - doc: import Markdown as a Feishu Docs document, then send only the doc link
FEISHU_SEND_MODE=app_doc

# For app_doc:
# - import: import Markdown into a Docx, then send an app card to FEISHU_CHAT_ID
# - blocks: create Docx and write blocks directly; falls back to import if block writing fails
FEISHU_APP_DOC_METHOD=import

# Required for FEISHU_SEND_MODE=app_doc/doc.
FEISHU_APP_ID=cli_REPLACE_ME
FEISHU_APP_SECRET=

# Optional for FEISHU_SEND_MODE=app_doc. Daily report group chat_id, usually starts with oc_.
# Empty means create the Docx but do not share/send a group message.
FEISHU_CHAT_ID=

# Optional. Permission granted to FEISHU_CHAT_ID before sending the card.
FEISHU_CHAT_SHARE_PERM=edit

# Optional. Folder token where imported Docs should be saved.
# Empty means Feishu's default import location for this app, and is the safest working default.
# If set, the app must have write/mount permission on that folder; otherwise import may return mount_no_permission.
FEISHU_DOC_FOLDER_TOKEN=
FEISHU_DOC_IMPORT_TIMEOUT=120

# Optional fallback: after importing a document, add one user/group as collaborator.
# Requires docs:permission.member:create or another permission scope that can add doc collaborators.
# Examples:
#   FEISHU_DOC_SHARE_MEMBER_TYPE=email
#   FEISHU_DOC_SHARE_MEMBER_ID=you@example.com
#   FEISHU_DOC_SHARE_SUBJECT_TYPE=user
#   FEISHU_DOC_SHARE_PERM=edit
# For a group:
#   FEISHU_DOC_SHARE_MEMBER_TYPE=openchat
#   FEISHU_DOC_SHARE_MEMBER_ID=<your-chat-id>
#   FEISHU_DOC_SHARE_SUBJECT_TYPE=chat
FEISHU_DOC_SHARE_MEMBER_TYPE=email
FEISHU_DOC_SHARE_MEMBER_ID=
FEISHU_DOC_SHARE_SUBJECT_TYPE=user
FEISHU_DOC_SHARE_PERM=edit
