{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "测试日报候选审核输出 v2",
  "type": "object",
  "required": ["schema_version", "date", "snapshot_sha256", "items", "funding_records"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "date": {"type": "string", "pattern": "^\\d{8}$"},
    "snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "actions", "reason", "confidence"],
        "additionalProperties": false,
        "properties": {
          "url": {"type": "string", "minLength": 1},
          "actions": {
            "type": "object",
            "required": ["business_v2_strict", "business_v2_balanced", "business_v2_recall"],
            "additionalProperties": false,
            "properties": {
              "business_v2_strict": {"enum": ["keep", "hold", "remove", "promote"]},
              "business_v2_balanced": {"enum": ["keep", "hold", "remove", "promote"]},
              "business_v2_recall": {"enum": ["keep", "hold", "remove", "promote"]}
            }
          },
          "reason": {"type": "string", "minLength": 1, "maxLength": 240},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "funding_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "company", "business", "business_model", "valuation", "evidence_excerpt"],
        "additionalProperties": false,
        "properties": {
          "url": {"type": "string", "minLength": 1},
          "company": {"type": "string", "minLength": 1, "maxLength": 120},
          "business": {"type": "string", "minLength": 1, "maxLength": 280},
          "business_model": {"type": "string", "minLength": 1, "maxLength": 280},
          "valuation": {"type": "string", "minLength": 1, "maxLength": 120},
          "evidence_excerpt": {"type": "string", "minLength": 1, "maxLength": 360}
        }
      }
    }
  }
}
